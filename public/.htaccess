# Me Gusta (Hostinger / Apache / LiteSpeed)

Options -Indexes
DirectoryIndex index.php index.html

# Hostinger Git deployment keeps a .git folder here: never serve it.
RedirectMatch 404 /\.git

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Pass the admin's sign-in token to PHP (some servers drop the Authorization header).
  RewriteCond %{HTTP:Authorization} .
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

  # Server code and the schema are not public.
  RewriteRule ^lib(/|$) - [F,L]

  # index.html is the template index.php fills in.
  RewriteRule ^index\.html$ / [R=301,L]

  # JSON API, uploaded images, sitemap and robots.txt.
  RewriteCond %{REQUEST_URI} !^/api/(index|media)\.php
  RewriteRule ^api(/.*)?$ api/index.php [L,QSA]
  RewriteRule ^media/([a-f0-9]{20}\.(webp|jpg|png))$ api/media.php?f=$1 [L,QSA]
  RewriteRule ^sitemap\.xml$ sitemap.php [L]
  RewriteRule ^robots\.txt$ robots.php [L]

  # Pages have real paths (/tvarkarastis, /naujienos, /<naujiena> ...): any address that is
  # not an existing file or folder goes to index.php, which adds SEO tags and content.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.php [L]
</IfModule>

# Compress text files
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript image/svg+xml application/json application/xml text/plain
</IfModule>

# Built assets have content hashes in their names, so they can be cached for a year.
# Pages (index.php) send their own no-cache header, so edits show up immediately.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
